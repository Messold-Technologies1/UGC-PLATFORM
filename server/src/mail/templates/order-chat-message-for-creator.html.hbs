{{!-- context: recipientName, platformName, senderName, unreadCount, messagePreview, orderId, packageName, actionUrl --}}
<p style="margin:0 0 8px;font-size:15px;line-height:1.5;color:#6b7280;">Hi {{recipientName}}, 👋</p>
<p style="margin:0 0 16px;font-size:24px;font-weight:800;line-height:1.2;color:#111827;letter-spacing:-0.02em;">New message from {{senderName}} 💬</p>
<p style="margin:0 0 16px;font-size:16px;line-height:1.6;color:#374151;">
  You have {{#if unreadCount}}{{unreadCount}} unread message(s){{else}}a message{{/if}} from {{senderName}} about your order <span style="font-family:monospace;font-size:14px;">{{orderId}}</span>.
</p>
{{#if messagePreview}}
<div style="margin:0 0 20px;padding:14px 16px;background:#f9fafb;border:2px solid #181313;border-radius:12px;">
  <p style="margin:0;font-size:14px;line-height:1.55;color:#111827;">{{messagePreview}}</p>
</div>
{{/if}}
<div style="margin:0 0 24px;">
  {{> actionButton url=actionUrl label="Open chat →"}}
</div>
<p style="margin:0;font-size:14px;line-height:1.5;color:#6b7280;">— The {{platformName}} team 🚀</p>
