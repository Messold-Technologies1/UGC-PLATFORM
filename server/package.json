{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build -b swc",
    "postinstall": "prisma generate",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start -b swc",
    "start:dev": "nest start --watch -b swc",
    "start:debug": "nest start --debug --watch -b swc",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "TS_NODE_PROJECT=prisma/tsconfig.scripts.json node -r ts-node/register/transpile-only prisma/seed.ts",
    "prisma:backfill:creator-approvals": "ts-node prisma/backfill-creator-approvals.ts",
    "prisma:backfill:creator-public-slug": "ts-node prisma/backfill-creator-public-slug.ts",
    "prisma:backfill:creator-complete-profile": "ts-node prisma/backfill-creator-complete-profile.ts",
    "prisma:backfill:recompute-listing": "ts-node prisma/backfill-recompute-listing.ts",
    "prisma:backfill:notification-preferences": "ts-node prisma/backfill-notification-preferences.ts",
    "prisma:backfill:resolve-dual-role-users": "ts-node prisma/backfill-resolve-dual-role-users.ts",
    "prisma:backfill:creator-restriction-suggestions": "TS_NODE_PROJECT=prisma/tsconfig.scripts.json node -r ts-node/register/transpile-only prisma/backfill-creator-restriction-suggestions.ts",
    "prisma:seed:cities": "ts-node prisma/seed-cities.ts",
    "prisma:seed:ai-search-creators": "ts-node prisma/seed-ai-search-test-creators.ts",
    "prisma:backfill:seed-media-s3": "ts-node prisma/backfill-seed-portfolio-videos-to-s3.ts",
    "prisma:backfill:seed-portfolio-s3": "npm run prisma:backfill:seed-media-s3",
    "data:gen:aliases": "ts-node prisma/scripts/generate-india-location-aliases.ts"
  },
  "prisma": {
    "seed": "TS_NODE_PROJECT=prisma/tsconfig.scripts.json node -r ts-node/register/transpile-only prisma/seed.ts"
  },
