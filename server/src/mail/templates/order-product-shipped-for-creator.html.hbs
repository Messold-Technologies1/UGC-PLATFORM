{{!-- context: recipientName, platformName, brandName, orderId, courierName, trackingId, dispatchedAt, actionUrl --}}
<p style="margin:0 0 8px;font-size:15px;line-height:1.5;color:#6b7280;">Hi {{recipientName}}, 👋</p>
<p style="margin:0 0 16px;font-size:24px;font-weight:800;line-height:1.2;color:#111827;letter-spacing:-0.02em;">It's on the way! 📦</p>
<p style="margin:0 0 16px;font-size:16px;line-height:1.6;color:#374151;">
  <strong>{{brandName}}</strong> shipped the product for your order. Once it lands, confirm receipt so you can start creating.
</p>
<div style="margin:0 0 20px;padding:14px 16px;background:#fafafa;border:2px solid #111827;border-radius:12px;">
  <p style="margin:0 0 6px;font-size:14px;line-height:1.6;color:#374151;"><strong>Order:</strong> {{orderId}}</p>
  <p style="margin:0 0 6px;font-size:14px;line-height:1.6;color:#374151;"><strong>Courier:</strong> {{courierName}}</p>
  <p style="margin:0 0 6px;font-size:14px;line-height:1.6;color:#374151;"><strong>Tracking:</strong> {{trackingId}}</p>
  <p style="margin:0;font-size:14px;line-height:1.6;color:#374151;"><strong>Dispatched:</strong> {{dispatchedAt}}</p>
</div>
<div style="margin:0 0 24px;">
  {{> actionButton url=actionUrl label="Confirm receipt →"}}
</div>
<p style="margin:0;font-size:14px;line-height:1.5;color:#6b7280;">— The {{platformName}} team 📦</p>
