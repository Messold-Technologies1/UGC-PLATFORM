  @@index([status, openedAt])
}

model CreatorPortfolioVideo {
  id        String @id @default(uuid()) @db.Uuid
  creatorId String @db.Uuid

  /// Nullable because an Instagram import exists before its mirror finishes,
  /// and stays null for the lifetime of a LINK_ONLY row. Every read must
  /// tolerate that; the public profile filters on assetState instead.
  videoKey     String?
  videoUrl     String?
  thumbnailKey String?
  thumbnailUrl String?

  visibilityStatus PortfolioVisibilityStatus @default(PUBLIC)

  /// Where the video came from. UPLOAD rows are always READY.
  source     PortfolioVideoSource     @default(UPLOAD)
  assetState PortfolioVideoAssetState @default(READY)

  /// Instagram provenance, set when source = INSTAGRAM.
  igMediaId   String?
  igPermalink String?
  igPostedAt  DateTime?
  importedAt  DateTime?

  /// Mirror bookkeeping, following OrderDelivery.previewAttempts /
  /// previewUpdatedAt. `mirrorClaimedAt` is what makes the claim a genuine
  /// cross-instance lock: an in-memory Set only guards one process, so the
  /// worker replica and an API replica's inline fallback could both stream the
  /// same reel. A claim older than the stale window is treated as abandoned,
  /// which is also the only way a process that died mid-mirror gets recovered.
  mirrorAttempts  Int       @default(0)
  mirrorClaimedAt DateTime?
  /// SHA-256 hex of the uploaded bytes, supplied by the client. Used only to
  /// stop the same file being added to one portfolio twice; null for rows
  /// created before the guard existed, or for files too large to hash in the
  /// browser. NULLs do not collide under the unique index below.
  contentHash      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  creator       CreatorProfile                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  sectionVideos CreatorPortfolioSectionVideo[]
  /// The cached reel(s) pointing at this row, so deleting it un-dims the tile.
  igMediaItems  InstagramMediaItem[]

  @@unique([creatorId, contentHash])
  /// One Instagram reel can only be imported into a portfolio once.
  @@unique([creatorId, igMediaId])
  @@index([creatorId, visibilityStatus, createdAt])
  @@index([creatorId, createdAt])
  @@index([assetState])
  /// Drives the stuck-mirror reconcile scan.
  @@index([assetState, mirrorClaimedAt])
}

