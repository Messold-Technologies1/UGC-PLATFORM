{{!-- context: recipientName, platformName, brandName, creatorName, packageName, orderId, daysAdded, totalUsageDays, actionUrl --}}
<p style="margin:0 0 8px;font-size:15px;line-height:1.5;color:#6b7280;">Hi {{recipientName}}, 👋</p>
<p style="margin:0 0 16px;font-size:24px;font-weight:800;line-height:1.2;color:#111827;letter-spacing:-0.02em;">Usage rights extended ✅</p>
<p style="margin:0 0 16px;font-size:16px;line-height:1.6;color:#374151;">
  Your extension is confirmed. You added <strong>{{daysAdded}} days</strong> of content usage rights on your order for <strong>"{{packageName}}"</strong>.
</p>
<p style="margin:0 0 20px;font-size:15px;line-height:1.5;color:#374151;">
  This order now includes <strong>{{totalUsageDays}} days</strong> of usage rights in total.
</p>
<p style="margin:0 0 20px;font-size:14px;line-height:1.5;color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:12px 14px;">
  ⚠️ Usage-rights extensions are <strong>non-refundable</strong>.
</p>
<div style="margin:0 0 24px;">
  {{> actionButton url=actionUrl label="View order →"}}
</div>
<p style="margin:0;font-size:14px;line-height:1.5;color:#6b7280;">— The {{platformName}} team ✨</p>
