{{!-- context: recipientName, platformName, actionUrl, expiresInMinutes --}}
<p style="margin:0 0 16px;font-size:16px;line-height:1.5;color:#111827;">Hi {{recipientName}},</p>
<p style="margin:0 0 16px;font-size:16px;line-height:1.5;color:#374151;">
  We received a request to reset your password for <strong>{{platformName}}</strong>.
  Click the button below to choose a new password. This link expires in {{expiresInMinutes}} minutes.
</p>
<div style="margin:0 0 24px;">
  {{> actionButton url=actionUrl label="Reset password"}}
</div>
<p style="margin:0 0 16px;font-size:14px;line-height:1.5;color:#6b7280;">
  If you did not request this, you can safely ignore this email. Your password will not change.
</p>
<p style="margin:0;font-size:14px;line-height:1.5;color:#6b7280;">— The {{platformName}} team</p>
