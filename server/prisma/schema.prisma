generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthProvider {
  GOOGLE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RoleName {
  ADMIN
  CREATOR
  BRAND
}

enum PortfolioVisibilityStatus {
  PUBLIC
  PRIVATE
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  name          String?
  passwordHash  String?
  phone         String?
  emailVerified Boolean    @default(false)
  phoneVerified Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  primaryRoleId String?    @db.Uuid
  brandAccessRevokedAt        DateTime?
  brandAccessRevokedById      String?    @db.Uuid
  brandAccessRevocationReason String?

  primaryRole            Role?             @relation("PrimaryUserRole", fields: [primaryRoleId], references: [id], onDelete: SetNull)
  authAccounts           AuthAccount[]
  sessions               Session[]
  userRoles              UserRole[]
  creatorProfile         CreatorProfile?
  brandProfile           BrandProfile?
  approvedCreatorRecords CreatorApproval[] @relation("CreatorApprovedBy")
  featuredCreatorRecords CreatorFeature[]  @relation("CreatorFeaturedBy")
  auditLogs              AuditLog[]        @relation("AuditLogActor")

  @@index([status])
  @@index([deletedAt])
  @@index([primaryRoleId])
  @@index([brandAccessRevokedAt])
}

model AuthAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String
  refreshToken   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique
  activeRoleId     String?  @db.Uuid
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeRole Role? @relation("ActiveSessionRole", fields: [activeRoleId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([userId, activeRoleId])
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      RoleName @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
  primaryUsers    User[]           @relation("PrimaryUserRole")
  activeSessions  Session[]        @relation("ActiveSessionRole")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model CreatorProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  displayName  String
  profileImageKey String?
  profileImageUrl String?
  city         String?
  bio          String?
  gender       String?
  travelRadius Int?
  onLocationAvailable Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorApproval CreatorApproval?
  languages       CreatorLanguage[]
  categories      CreatorCategory[]
  personaTags     CreatorPersonaTag[]
  restrictions    CreatorRestriction[]
  stats           CreatorStats?
  features        CreatorFeature[]
  packages        CreatorPackage[]
  addOns          CreatorAddOn[]
  portfolioVideos CreatorPortfolioVideo[]


  @@index([city])
  @@index([gender])
  @@index([onLocationAvailable])
  @@index([createdAt])
}

model CreatorPortfolioVideo {
  id               String                   @id @default(uuid()) @db.Uuid
  creatorId        String                   @db.Uuid
  videoKey         String
  videoUrl         String
  thumbnailKey     String?
  thumbnailUrl     String?
  industryLabel    String?
  language         String?
  description      String?
  visibilityStatus PortfolioVisibilityStatus @default(PUBLIC)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  creator CreatorProfile            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  tags    CreatorPortfolioVideoTag[]

  @@index([creatorId, visibilityStatus, createdAt])
  @@index([creatorId, createdAt])
  @@index([visibilityStatus, industryLabel])
}

model CreatorPortfolioVideoTag {
  id        String   @id @default(uuid()) @db.Uuid
  videoId   String   @db.Uuid
  tag       String
  createdAt DateTime @default(now())

  video CreatorPortfolioVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, tag])
  @@index([tag])
}

model PortfolioIndustrySuggestion {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
}

model PortfolioTagSuggestion {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
}

model PortfolioLanguageSuggestion {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
}

model CreatorApproval {
  id              String         @id @default(uuid()) @db.Uuid
  creatorId       String         @unique @db.Uuid
  status          ApprovalStatus @default(PENDING)
  approvedById    String?        @db.Uuid
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  approvedBy User?          @relation("CreatorApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([approvedById])
}

model CreatorLanguage {
  id        String   @id @default(uuid()) @db.Uuid
  creatorId String   @db.Uuid
  language  String
  createdAt DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, language])
  @@index([language])
}

model CreatorCategory {
  id        String   @id @default(uuid()) @db.Uuid
  creatorId String   @db.Uuid
  category  String
  createdAt DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, category])
  @@index([category])
}

model CreatorPersonaTag {
  id        String   @id @default(uuid()) @db.Uuid
  creatorId String   @db.Uuid
  tag       String
  createdAt DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, tag])
  @@index([tag])
}

model CreatorRestriction {
  id          String   @id @default(uuid()) @db.Uuid
  creatorId   String   @db.Uuid
  restriction String
  createdAt   DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, restriction])
  @@index([restriction])
}

model CreatorCategorySuggestion {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
}

model CreatorPersonaTagSuggestion {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
}

model CreatorRestrictionSuggestion {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
}

model BrandProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  companyName   String
  logoKey       String?
  logoUrl       String?
  website       String?
  industry      String?
  contactPerson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreatorStats {
  id                 String   @id @default(uuid()) @db.Uuid
  creatorId          String   @unique @db.Uuid
  totalOrders        Int      @default(0)
  completedOrders    Int      @default(0)
  cancelledOrders    Int      @default(0)
  disputesCount      Int      @default(0)
  avgRating          Decimal? @db.Decimal(3, 2)
  responseTimeAvg    Int? // in minutes
  onTimeDeliveryRate Decimal? @db.Decimal(5, 2)
  acceptanceRate     Decimal? @db.Decimal(5, 2)
  updatedAt          DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model CreatorFeature {
  id            String    @id @default(uuid()) @db.Uuid
  creatorId     String    @db.Uuid
  isFeatured    Boolean   @default(false)
  featuredById  String?   @db.Uuid
  featuredUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  featuredBy User?          @relation("CreatorFeaturedBy", fields: [featuredById], references: [id], onDelete: SetNull)

  @@index([creatorId, isFeatured])
  @@index([featuredUntil])
}

model CreatorPackage {
  id           String   @id @default(uuid()) @db.Uuid
  creatorId    String   @db.Uuid
  name         String
  title        String?
  deliverables Json     // array of strings e.g. ["1 Video", "Basic editing"]
  priceAmount  Decimal  @db.Decimal(12, 2)
  deliveryDays Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([priceAmount])
}

model CreatorAddOn {
  id          String   @id @default(uuid()) @db.Uuid
  creatorId   String   @db.Uuid
  name        String
  priceAmount Decimal  @db.Decimal(12, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
