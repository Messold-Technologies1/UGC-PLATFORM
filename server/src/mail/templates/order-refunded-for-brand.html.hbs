{{!-- context: recipientName, platformName, packageName, orderId, refundAmount, refundedAt, actionUrl --}}
<p style="margin:0 0 8px;font-size:15px;line-height:1.5;color:#6b7280;">Hi {{recipientName}}, 👋</p>
<p style="margin:0 0 16px;font-size:24px;font-weight:800;line-height:1.2;color:#111827;letter-spacing:-0.02em;">Refund processed 💳</p>
<p style="margin:0 0 16px;font-size:16px;line-height:1.6;color:#374151;">
  Your payment for order <span style="font-family:monospace;font-size:14px;">{{orderId}}</span> (<strong>"{{packageName}}"</strong>) has been refunded.
</p>
<div style="margin:0 0 20px;padding:14px 16px;background:#fafafa;border:2px solid #111827;border-radius:12px;">
  <p style="margin:0 0 6px;font-size:14px;line-height:1.6;color:#374151;"><strong>Amount:</strong> <strong>{{refundAmount}}</strong></p>
  <p style="margin:0;font-size:14px;line-height:1.6;color:#374151;"><strong>Refunded on:</strong> {{refundedAt}}</p>
</div>
<p style="margin:0 0 20px;font-size:16px;line-height:1.6;color:#374151;">
  Depending on your bank, it may take a few business days to show up in your account.
</p>
<div style="margin:0 0 24px;">
  {{> actionButton url=actionUrl label="View order →"}}
</div>
<p style="margin:0;font-size:14px;line-height:1.5;color:#6b7280;">— The {{platformName}} team</p>
