{{!-- context: recipientName, platformName, packageName, creatorName, orderId, resolutionNotes (optional), actionUrl --}}
<p style="margin:0 0 16px;font-size:16px;line-height:1.5;color:#111827;">Hi {{recipientName}},</p>
<p style="margin:0 0 16px;font-size:16px;line-height:1.5;color:#374151;">
  After review, order
  <span style="font-family:monospace;font-size:14px;">{{orderId}}</span> for
  <strong>"{{packageName}}"</strong> with <strong>{{creatorName}}</strong> was not approved and has been closed.
</p>
{{#if resolutionNotes}}
<div style="margin:0 0 16px;padding:12px 16px;background:#f9fafb;border-left:4px solid #9ca3af;border-radius:4px;">
  <p style="margin:0 0 4px;font-size:13px;font-weight:600;color:#4b5563;">Resolution notes</p>
  <p style="margin:0;font-size:15px;line-height:1.5;color:#374151;">{{resolutionNotes}}</p>
</div>
{{/if}}
<p style="margin:0 0 20px;font-size:16px;line-height:1.5;color:#374151;">
  A refund to your original payment method will be processed shortly. You will receive another email once the refund is complete.
</p>
<div style="margin:0 0 24px;">
  {{> actionButton url=actionUrl label="View order"}}
</div>
<p style="margin:0;font-size:14px;line-height:1.5;color:#6b7280;">— The {{platformName}} team</p>
