generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector"), pg_trgm]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthProvider {
  GOOGLE
}

enum SocialPlatform {
  INSTAGRAM
  YOUTUBE
  REDDIT
}

enum SocialConnectionStatus {
  ACTIVE // token valid, syncing normally
  EXPIRED // token expired / refresh failed — needs reconnect
  REVOKED // user disconnected or revoked access on the platform
  ERROR // repeated sync failures; left connected for retry/diagnosis
}

enum EmailSuppressionReason {
  HARD_BOUNCE
  COMPLAINT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SHORTLISTED
  SELF_COMPLETED
}

enum RoleName {
  ADMIN
  CREATOR
  BRAND
  AGENCY
}

enum PortfolioVideoSource {
  UPLOAD
  INSTAGRAM
}

/// READY     — playable from our CDN.
/// PROCESSING— row exists, the mirror job has not finished yet.
/// FAILED    — the mirror gave up; the creator can retry.
/// LINK_ONLY — deliberately never mirrored (PORTFOLIO_IG_IMPORT_MODE=link).
enum PortfolioVideoAssetState {
  READY
  PROCESSING
  FAILED
  LINK_ONLY
}

enum IgMediaSyncStatus {
  IDLE
  QUEUED
  SYNCING
  READY
  ERROR
}

enum PortfolioVisibilityStatus {
  PUBLIC
  PRIVATE
}

enum OrderStatus {
  PENDING_PAYMENT
  BRIEF_SUBMISSION_PENDING
  BRIEF_SUBMITTED
  BRIEF_ACCEPTED
  PRODUCT_SHIPPED
  PRODUCT_RECEIVED
  DELIVERED
  REVISION_REQUESTED
  REVISION_SUBMITTED
  ACCEPTED
  CREATOR_PAYMENT_DONE
  DISPUTED
  REJECTED
  REFUNDED
}

enum OrderDisputeStatus {
  OPEN
  RESOLVED_CONTINUE
  RESOLVED_REFUNDED
  RESOLVED_CLOSED
}

enum OrderDisputeOpenedBy {
  BRAND
  CREATOR
}

enum ContactMessageStatus {
  PENDING
  READ
}

enum BrandCategory {
  APPAREL_AND_FASHION
  ELECTRONICS_AND_GADGETS
  HEALTH_AND_BEAUTY
  FOOD_AND_BEVERAGES
  HOME_AND_LIFESTYLE
  SPORTS_AND_FITNESS
  TOYS_AND_KIDS
  PETS_AND_ANIMALS
  AUTOMOBILE_AND_VEHICLES
  REAL_ESTATE
  RESTAURANTS_AND_CAFES
  CLINICS_AND_HEALTHCARE
  SALONS_AND_PERSONAL_CARE
  EDUCATION_AND_COACHING
  TRAVEL_AND_HOSPITALITY
  LOCAL_BUSINESSES
  SAAS_AND_APPS
  PROFESSIONAL_SERVICES
  OTHER
}

enum BrandProductType {
  PHYSICAL
  DIGITAL
  BOTH
}

enum CreatorFacetDimension {
  CONTENT_CATEGORY
  CREATOR_TYPE
  OCCUPATION
  APPEARANCE
  LANGUAGE
}

enum CreatorGender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
  OTHER
}

enum CreatorContentVolumeBucket {
  NONE
  RANGE_1_5
  RANGE_5_15
  RANGE_15_25
  RANGE_25_50
  RANGE_50_PLUS
}

enum CreatorAgeGroup {
  AGE_18_24
  AGE_25_34
  AGE_35_44
  AGE_45_54
  AGE_55_PLUS
}

model User {
  id                          String     @id @default(uuid()) @db.Uuid
  email                       String     @unique
  name                        String?
  passwordHash                String?
  phone                       String?
  emailVerified               Boolean    @default(false)
  phoneVerified               Boolean    @default(false)
  phoneOtpFailedAttempts      Int        @default(0)
  phoneOtpLastAttemptAt       DateTime?
  phoneOtpLastStatus          String?
  phoneOtpLastPhone           String?
  status                      UserStatus @default(ACTIVE)
  deletedAt                   DateTime?
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt
  primaryRoleId               String?    @db.Uuid
  brandAccessRevokedAt        DateTime?
  brandAccessRevokedById      String?    @db.Uuid
  brandAccessRevocationReason String?

  primaryRole            Role?                @relation("PrimaryUserRole", fields: [primaryRoleId], references: [id], onDelete: SetNull)
  authAccounts           AuthAccount[]
  sessions               Session[]
  userRoles              UserRole[]
  creatorProfile         CreatorProfile?
  brandProfile           BrandProfile?
  ownedAgency            Agency?
  approvedCreatorRecords CreatorApproval[]    @relation("CreatorApprovedBy")
  featuredCreatorRecords CreatorFeature[]     @relation("CreatorFeaturedBy")
  auditLogs              AuditLog[]           @relation("AuditLogActor")
  resolvedDisputes       OrderDispute[]       @relation("OrderDisputeResolvedBy")
  requestedRevisions     OrderRevision[]      @relation("OrderRevisionRequester")
  revisionPurchases      OrderRevisionPurchase[] @relation("RevisionPurchaseCreator")
  usageRightsPurchases   OrderUsageRightsPurchase[] @relation("UsageRightsPurchaseCreator")
  sentChatMessages       OrderChatMessage[]
  orderChatReadStates    OrderChatReadState[]
  passwordResetTokens    PasswordResetToken[]
  contactMessagesRead    ContactMessage[]     @relation("ContactMessageReadBy")

  @@index([status])
  @@index([deletedAt])
  @@index([primaryRoleId])
  @@index([brandAccessRevokedAt])
  @@index([phoneOtpLastAttemptAt])
}

model ContactMessage {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  email     String
  role      String
  subject   String
  message   String
  createdAt DateTime             @default(now())
  status    ContactMessageStatus @default(PENDING)
  readById  String?              @db.Uuid

  readBy User? @relation("ContactMessageReadBy", fields: [readById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status, createdAt])
}

model AuthAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String
  refreshToken   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      RoleName @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
  primaryUsers    User[]           @relation("PrimaryUserRole")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model CreatorProfile {
  id                           String                      @id @default(uuid()) @db.Uuid
  userId                       String                      @unique @db.Uuid
  displayName                  String
  /// Unique URL slug for public profile (e.g. "riyasharma" or "riyasharma-4821").
  publicSlug                   String                      @unique
  introVideoKey                String?
  introVideoUrl                String?
  profileImageKey              String?
  profileImageUrl              String?
  city                         String?
  countryName                  String?
  stateName                    String?
  bio                          String?
  gender                       CreatorGender?
  dateOfBirth                  DateTime?                   @db.Date
  shippingAddress              String?
  /// Primary contact email for orders and platform communication.
  contactEmail                 String?
  instagramUrl                 String?
  /// Optional Google Drive folder/file link shared at signup (viewer access).
  driveLink                    String?
  youtubeUrl                   String?
  snapchatUrl                  String?
  contentVolume                CreatorContentVolumeBucket?
  collaborationCount           Int                         @default(0)
  travelRadius                 Int?
  onLocationAvailable          Boolean                     @default(false)
  /// One-way latch: set true the first time the creator meets every Go-Live
  /// requirement. Never reverts — later edits/deletions do not clear it.
  completeProfile              Boolean                     @default(false)
  /// Derived discovery gate = (approval APPROVED) AND completeProfile.
  /// Brands only ever see creators where this is true.
  isListed                     Boolean                     @default(false)
  /// Opt-in for transactional/profile/order emails. Set true at signup; legacy rows backfilled false.
  emailNotificationsEnabled    Boolean                     @default(false)
  /// Opt-in for WhatsApp notifications (enforced when WhatsApp delivery is wired).
  whatsappNotificationsEnabled Boolean                     @default(false)
  /// Meta (Facebook) attribution identifiers captured in the creator's browser
  /// at signup. Replayed via the Conversions API when the creator is listed so
  /// the (out-of-band, admin-triggered) conversion attributes to the ad the
  /// creator originally clicked. All optional — tracking is best-effort.
  metaFbp                      String?
  metaFbc                      String?
  metaSignupIp                 String?
  metaSignupUserAgent          String?
  /// Profile-completion reminder emails sent while the profile is still building
  /// (completeProfile = false). Each stamp is set once, when its reminder is
  /// handled, so the reminder job stays idempotent. All nullable/additive.
  completionReminder30mAt      DateTime?
  completionReminder24hAt      DateTime?
  completionReminder48hAt      DateTime?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorApproval   CreatorApproval?
  facetSelections   CreatorProfileFacetSelection[]
  profileLanguages  CreatorProfileLanguage[]
  restrictions      CreatorRestriction[]
  stats             CreatorStats?
  feature           CreatorFeature?
  packages          CreatorPackage[]
  addOns            CreatorAddOn[]
  portfolioVideos   CreatorPortfolioVideo[]
  portfolioSections CreatorPortfolioSection[]
  receivedOrders    Order[]                        @relation("OrderCreator")
  orderDeliveries   OrderDelivery[]
  payoutDetails     CreatorPayoutDetails?
  ratingReviews     CreatorRatingReview[]
  wishlistEntries   BrandWishlistCreator[]
  unavailability    CreatorUnavailability?
  socialConnections SocialConnection[]

  @@index([city])
  @@index([countryName])
  @@index([dateOfBirth])
  @@index([gender])
  @@index([onLocationAvailable])
  @@index([isListed])
  @@index([completeProfile])
  @@index([completeProfile, isListed])
  // Serves the completion-reminder poll: WHERE completeProfile = false AND createdAt in window.
  @@index([completeProfile, createdAt])
  @@index([createdAt])
  // Matches the browse-list hot path: WHERE isListed = true ORDER BY createdAt DESC.
  @@index([isListed, createdAt(sort: Desc)])
  // Trigram GIN indexes for free-text contains/ILIKE search (migration 20260714153600).
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "CreatorProfile_displayName_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "CreatorProfile_city_trgm_idx")
  @@index([stateName(ops: raw("gin_trgm_ops"))], type: Gin, map: "CreatorProfile_stateName_trgm_idx")
  @@index([countryName(ops: raw("gin_trgm_ops"))], type: Gin, map: "CreatorProfile_countryName_trgm_idx")
  @@index([bio(ops: raw("gin_trgm_ops"))], type: Gin, map: "CreatorProfile_bio_trgm_idx")
}

/// Canonical Indian states for AI-search location resolution. Names mirror the
/// `country-state-city` catalog (the same vocabulary creators select at signup),
/// so a creator's stored `CreatorProfile.stateName` always matches a row here.
/// `aliasesNormalized` holds lowercased alternate spellings (e.g. "orissa" for
/// Odisha) so a brand's free-typed query still resolves to the canonical name.
/// Standalone reference data — no FK from CreatorProfile (kept removable).
model State {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  countryCode       String
  aliasesNormalized String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cities City[]

  @@unique([countryCode, name])
  @@index([aliasesNormalized], type: Gin)
}

/// Canonical Indian cities for AI-search location resolution. See `State`.
/// `aliasesNormalized` (e.g. "bombay" for Mumbai, "bangalore" for Bengaluru)
/// lets the resolver expand a brand's query to the canonical name before the
/// hard filter runs, so a creator stored as "Mumbai" is never missed.
model City {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  stateId           String   @db.Uuid
  stateName         String
  countryCode       String
  aliasesNormalized String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([countryCode, stateName, name])
  @@index([name])
  @@index([aliasesNormalized], type: Gin)
}

model CreatorFacetOption {
  id        String                @id @default(uuid()) @db.Uuid
  dimension CreatorFacetDimension
  slug      String
  label     String
  sortOrder Int                   @default(0)
  // "active" options show in the pick lists. Creator-proposed options added via
  // the AI "Other" resolver are created active; "rejected" hides an option
  // (soft-delete) without breaking existing selections that reference it.
  status    String                @default("active")
  // Creator who first proposed this option through the "Other" flow (audit;
  // null for seeded catalog options).
  proposedByCreatorId String?     @db.Uuid
  createdAt DateTime              @default(now())

  selections       CreatorProfileFacetSelection[]
  profileLanguages CreatorProfileLanguage[]       @relation("LanguageOption")
  aliases          CreatorFacetOptionAlias[]

  @@unique([dimension, slug])
  @@index([dimension, sortOrder])
  @@index([dimension, status])
}

// Learned synonym cache for the AI "Other" resolver. A normalized free-text
// entry maps to a canonical option so the next creator who types the same thing
// is resolved instantly (no AI call). Populated by exact/fuzzy/LLM matches.
model CreatorFacetOptionAlias {
  id             String                @id @default(uuid()) @db.Uuid
  dimension      CreatorFacetDimension
  normalizedText String
  optionId       String                @db.Uuid
  // How the alias was created: 'exact' | 'fuzzy' | 'llm' | 'manual'.
  source         String
  createdAt      DateTime              @default(now())

  option CreatorFacetOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([dimension, normalizedText])
  @@index([optionId])
}

model CreatorProfileFacetSelection {
  id               String   @id @default(uuid()) @db.Uuid
  creatorProfileId String   @db.Uuid
  optionId         String   @db.Uuid
  // Only meaningful for the CONTENT_CATEGORY (niche) dimension: 0 = primary
  // niche, 1..2 = secondary niches. Always 0 for the single-select dimensions.
  rank             Int      @default(0)
  // Free text captured when the selected option is the catalog "other" slug,
  // e.g. a niche/occupation not in the list. Null for normal selections.
  customLabel      String?
  createdAt        DateTime @default(now())

  creator CreatorProfile     @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  option  CreatorFacetOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([creatorProfileId, optionId])
  @@index([optionId])
}

model CreatorProfileLanguage {
  id               String   @id @default(uuid()) @db.Uuid
  creatorProfileId String   @db.Uuid
  optionId         String   @db.Uuid
  createdAt        DateTime @default(now())

  creator CreatorProfile     @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  option  CreatorFacetOption @relation("LanguageOption", fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([creatorProfileId, optionId])
  @@index([optionId])
}

/// Bank / UPI details for manual creator payouts. Full values are admin-only via API.
model CreatorPayoutDetails {
  id                String   @id @default(uuid()) @db.Uuid
  creatorId         String   @unique @db.Uuid
  accountHolderName String?
  accountNumber     String?
  ifsc              String?
  upiId             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  brandId          String      @db.Uuid
  creatorId        String      @db.Uuid
  /// Cleared if the listing package row is removed; use snapshot fields for purchased terms.
  creatorPackageId String?     @db.Uuid
  status           OrderStatus @default(PENDING_PAYMENT)

  // Snapshots at purchase time
  packageNameSnapshot  String
  deliverablesSnapshot Json
  priceAmountSnapshot  Decimal @db.Decimal(12, 2)
  currency             String  @default("INR")
  deliveryDaysSnapshot Int
  maxRevisionsSnapshot Int     @default(0)
  /// Extra content usage-rights days the brand has purchased after completion
  /// (each paid OrderUsageRightsPurchase increments this by daysAdded). The base
  /// 30 days lives only as descriptive text in deliverablesSnapshot; total usage
  /// days = BASE_USAGE_RIGHTS_DAYS + this.
  usageRightsExtraDays Int     @default(0)

  // Add-ons at purchase (catalog may change later)
  addOnsSnapshot      Json     @default("[]")
  addOnsTotalSnapshot Decimal? @db.Decimal(12, 2)
  expectedAmountPaise Int      @default(0)

  // Timeline
  paidAt           DateTime?
  briefId          String?   @db.Uuid
  briefSubmittedAt DateTime?
  briefAcceptedAt  DateTime?

  /// Snapshot from Brief at brief submit; when true, creator must confirm receipt before first delivery
  requiresPhysicalProductShipment Boolean   @default(false)
  courierName                     String?
  trackingId                      String?
  dispatchedAt                    DateTime?
  productReceivedAt               DateTime?

  deliveryDueAt           DateTime?
  deliveryGraceDeadlineAt DateTime?
  deliveredAt             DateTime?
  acceptedAt              DateTime?
  creatorPaidAt           DateTime?
  revisionCount           Int       @default(0)

  /// Order status captured at the moment a dispute is opened, so an admin
  /// resolution ("continue") or an opener withdrawal can restore the order
  /// to exactly the state it was in before the dispute.
  preDisputeStatus OrderStatus?

  // Razorpay Payments
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?
  razorpayRefundId  String?
  refundedAt        DateTime?

  /// Denormalized chat inbox: sort key (latest message time, or order activity when no messages).
  lastChatActivityAt          DateTime              @default(now())
  lastChatMessageId           String?               @db.Uuid
  lastChatMessageSenderUserId String?               @db.Uuid
  lastChatMessageType         OrderChatMessageType?
  lastChatMessageText         String?

  /// Set when this order was placed as part of a multi-creator bulk checkout
  /// (one payment, many orders). Null for ordinary single-creator checkouts,
  /// which keep their own razorpayOrderId 1:1 as before.
  checkoutBatchId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand          BrandProfile         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator        CreatorProfile       @relation("OrderCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  package        CreatorPackage?      @relation(fields: [creatorPackageId], references: [id], onDelete: SetNull)
  briefRef       Brief?               @relation(fields: [briefId], references: [id], onDelete: SetNull)
  checkoutBatch  OrderCheckoutBatch?  @relation(fields: [checkoutBatchId], references: [id], onDelete: SetNull)
  disputes       OrderDispute[]
  revisions      OrderRevision[]
  revisionPurchases OrderRevisionPurchase[]
  usageRightsPurchases OrderUsageRightsPurchase[]
  deliveries     OrderDelivery[]
  chatMessages   OrderChatMessage[]
  chatReadStates OrderChatReadState[]
  ratingReview   CreatorRatingReview?

  @@index([brandId, createdAt])
  @@index([creatorId, createdAt])
  @@index([brandId, lastChatActivityAt(sort: Desc)])
  @@index([creatorId, lastChatActivityAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([deliveryGraceDeadlineAt])
  @@index([briefId])
  @@index([checkoutBatchId])
}

enum OrderCheckoutBatchStatus {
  PENDING_PAYMENT
  PAID
  FAILED
}

/// A single payment that fans out into multiple orders (bulk checkout from the
/// wishlist). Holds the ONE Razorpay order for the whole cart; each child Order
/// links back via `checkoutBatchId` and leaves its own `razorpayOrderId` null.
/// Single-creator checkouts do not use this — they remain 1 Order ↔ 1 Razorpay
/// order via `Order.razorpayOrderId`.
model OrderCheckoutBatch {
  id                  String                   @id @default(uuid()) @db.Uuid
  brandId             String                   @db.Uuid
  status              OrderCheckoutBatchStatus @default(PENDING_PAYMENT)
  currency            String                   @default("INR")
  /// Grand total (sum of every child order's expectedAmountPaise); the amount
  /// the single Razorpay order is created for and verified against on capture.
  expectedAmountPaise Int
  razorpayOrderId     String?                  @unique
  razorpayPaymentId   String?
  paidAt              DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  brand  BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([brandId, createdAt])
}

enum OrderRevisionPurchaseStatus {
  PENDING_PAYMENT
  PAID
  FAILED
}

/// A supplemental, standalone charge on an already-paid Order: the brand buys
/// extra revisions once the order's revision cap is reached. Each paid purchase
/// increments `Order.maxRevisionsSnapshot` by `revisionsAdded`. Owns its own
/// Razorpay order + verifiable amount (the Order row can only hold one), exactly
/// like OrderCheckoutBatch does for bulk checkout. Unlimited per order.
model OrderRevisionPurchase {
  id                  String                      @id @default(uuid()) @db.Uuid
  orderId             String                      @db.Uuid
  /// Revisions this purchase grants once paid (REVISIONS_PER_ADDON, currently 2).
  revisionsAdded      Int
  /// Creator's "Revision" add-on price, in paise, snapshotted at purchase time.
  unitAmountPaise     Int
  /// Amount the Razorpay order is created for and verified against on capture.
  expectedAmountPaise Int
  currency            String                      @default("INR")
  status              OrderRevisionPurchaseStatus @default(PENDING_PAYMENT)
  razorpayOrderId     String?                     @unique
  razorpayPaymentId   String?
  paidAt              DateTime?
  createdByUserId     String                      @db.Uuid
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User  @relation("RevisionPurchaseCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum OrderUsageRightsPurchaseStatus {
  PENDING_PAYMENT
  PAID
  FAILED
}

/// A supplemental, standalone charge on a COMPLETED Order: the brand buys extra
/// content usage-rights time in 30-day blocks (non-refundable). Each paid purchase
/// increments `Order.usageRightsExtraDays` by `daysAdded`. Owns its own Razorpay
/// order + verifiable amount, exactly like OrderRevisionPurchase. Unlimited per
/// order.
model OrderUsageRightsPurchase {
  id                  String                         @id @default(uuid()) @db.Uuid
  orderId             String                         @db.Uuid
  /// Usage-rights days this purchase grants once paid (quantity * USAGE_RIGHTS_DAYS_PER_ADDON).
  daysAdded           Int
  /// Creator's "Usage Rights extra 30 days" add-on price, in paise, snapshotted at purchase time.
  unitAmountPaise     Int
  /// Amount the Razorpay order is created for and verified against on capture.
  expectedAmountPaise Int
  currency            String                         @default("INR")
  status              OrderUsageRightsPurchaseStatus @default(PENDING_PAYMENT)
  razorpayOrderId     String?                        @unique
  razorpayPaymentId   String?
  paidAt              DateTime?
  createdByUserId     String                         @db.Uuid
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User  @relation("UsageRightsPurchaseCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum BriefShootLocationKind {
  CREATOR_OWN_SETUP
  OUTDOOR_PUBLIC_LOCATION
  BRAND_SELECTED_LOCATION
  CREATOR_DECIDES
}

enum BriefDurationBucket {
