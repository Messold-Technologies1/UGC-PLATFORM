{{!-- context: recipientName, platformName, brandName, packageName, orderId, cancellationNote, actionUrl --}}
<p style="margin:0 0 8px;font-size:15px;line-height:1.5;color:#6b7280;">Hi {{recipientName}},</p>
<p style="margin:0 0 16px;font-size:22px;font-weight:800;line-height:1.25;color:#111827;letter-spacing:-0.02em;">Order cancelled by the brand</p>
<p style="margin:0 0 16px;font-size:16px;line-height:1.6;color:#374151;">
  <strong>{{brandName}}</strong> has cancelled order <span style="font-family:monospace;font-size:14px;">{{orderId}}</span> (<strong>"{{packageName}}"</strong>) before it started. No delivery or further action is required from you.
</p>
<div style="margin:0 0 16px;padding:14px 16px;background:#fafafa;border:2px solid #111827;border-radius:12px;">
  <p style="margin:0 0 6px;font-size:13px;font-weight:700;color:#111827;text-transform:uppercase;letter-spacing:0.04em;">Reason from {{brandName}}</p>
  <p style="margin:0;font-size:15px;line-height:1.55;color:#374151;">{{cancellationNote}}</p>
</div>
<p style="margin:0 0 20px;font-size:16px;line-height:1.6;color:#374151;">
  If you have questions, reply in the order chat or contact support.
</p>
<div style="margin:0 0 24px;">
  {{> actionButton url=actionUrl label="View order →"}}
</div>
<p style="margin:0;font-size:14px;line-height:1.5;color:#6b7280;">— The {{platformName}} team</p>
