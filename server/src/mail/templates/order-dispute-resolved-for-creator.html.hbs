{{!-- context: recipientName, platformName, outcomeMessage, resolutionNotes (optional), packageName, orderId, actionUrl --}}
<p style="margin:0 0 8px;font-size:15px;line-height:1.5;color:#6b7280;">Hi {{recipientName}},</p>
<p style="margin:0 0 16px;font-size:22px;font-weight:800;line-height:1.25;color:#111827;letter-spacing:-0.02em;">Dispute resolved</p>
<p style="margin:0 0 16px;font-size:16px;line-height:1.6;color:#374151;">
  Our team has resolved the dispute on order <span style="font-family:monospace;font-size:14px;">{{orderId}}</span> for <strong>"{{packageName}}"</strong>. {{outcomeMessage}}
</p>
{{#if resolutionNotes}}
<div style="margin:0 0 16px;padding:14px 16px;background:#f0fdf4;border:2px solid #16a34a;border-radius:12px;">
  <p style="margin:0 0 6px;font-size:13px;font-weight:700;color:#166534;text-transform:uppercase;letter-spacing:0.04em;">Resolution note from support</p>
  <p style="margin:0;font-size:15px;line-height:1.55;color:#374151;">{{resolutionNotes}}</p>
</div>
{{/if}}
<div style="margin:0 0 24px;">
  {{> actionButton url=actionUrl label="View order →"}}
</div>
<p style="margin:0;font-size:14px;line-height:1.5;color:#6b7280;">— The {{platformName}} team</p>
