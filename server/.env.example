# Neon PostgreSQL – use pooled URL for runtime, direct URL for migrations
# From Neon dashboard: Connection Details -> Pooled connection & Direct connection
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Server
NODE_ENV=development
PORT=4000

# Optional: enable Swagger in production (default: enabled when NODE_ENV !== production)
# SWAGGER_ENABLED=true

# Optional: CORS allowed origin (default: *)
# CORS_ORIGIN=http://localhost:3000

# Auth: JWT (min 16 chars each)
JWT_ACCESS_SECRET=your-access-secret-min-16-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Auth: Google OAuth (create app at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match Google Console. With Next on :3000 proxying /api/*, use :3000 here (same origin as /api/auth/google).
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Storage: S3 + CDN (presigned uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=your-s3-bucket
# Presigned URL expiry in seconds (default: 900)
S3_UPLOAD_URL_TTL_SECONDS=900
# CDN domain (CloudFront / custom). Used to construct public URLs from stored keys.
CDN_BASE_URL=https://cdn.example.com

# Razorpay Payments (TEST mode keys for local dev)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxx
# Webhook secret configured in Razorpay dashboard for your webhook URL
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxx

# Twilio Verify (SMS OTP for creator phone). Optional until you call /auth/phone/*.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Optional: one-time bootstrap admin created by `npm run prisma:seed`
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password
BOOTSTRAP_ADMIN_NAME=Platform Admin
