# Build-time settings for the production bundle.
#
# Everything here is compiled INTO the JavaScript that ships to browsers, so
# none of it is secret — that is what the NEXT_PUBLIC_ prefix means, and it is
# why this file is committed. Anything genuinely secret belongs in
# /etc/gocollab/client.env on the server, which is read at startup and never
# enters the bundle.
#
# Next loads this automatically during `next build`.

# The browser reaches the API through this app's own origin (the rewrite in
# next.config.ts), so this value is only a fallback for server-side rendering.
# The real server-side value is API_URL in /etc/gocollab/client.env.
NEXT_PUBLIC_API_URL=https://api.gocollab.io

NEXT_PUBLIC_SITE_URL=https://gocollab.io

# NOT proxied. The gateways are configured transports: ['websocket'] with no
# polling fallback, so the browser opens this socket straight to the API host.
# Point it anywhere else and realtime chat and payment events go silent with
# nothing in the logs.
NEXT_PUBLIC_SOCKET_URL=https://api.gocollab.io

# Leading dot: the cookie has to be readable on both gocollab.io and
# api.gocollab.io. Must match COOKIE_DOMAIN in the server's env file.
NEXT_PUBLIC_COOKIE_DOMAIN=.gocollab.io

# Must match CREATOR_ONBOARDING_MODE on the server.
NEXT_PUBLIC_CREATOR_ONBOARDING_MODE=profile_first

# Analytics / pixels. Left empty on purpose: each one is its own kill switch,
# and an empty value makes every tracking call a no-op. Fill in to enable.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_META_BRAND_PIXEL_ID=
