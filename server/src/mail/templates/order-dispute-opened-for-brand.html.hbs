{{!-- context: recipientName, platformName, raisedByLabel, reason, packageName, orderId, actionUrl --}}
<p style="margin:0 0 8px;font-size:15px;line-height:1.5;color:#6b7280;">Hi {{recipientName}},</p>
<p style="margin:0 0 16px;font-size:22px;font-weight:800;line-height:1.25;color:#111827;letter-spacing:-0.02em;">A dispute was opened</p>
<p style="margin:0 0 16px;font-size:16px;line-height:1.6;color:#374151;">
  A dispute was raised by the <strong>{{raisedByLabel}}</strong> on order <span style="font-family:monospace;font-size:14px;">{{orderId}}</span> for <strong>"{{packageName}}"</strong>. Our team is reviewing the case and may reach out in the order chat.
</p>
{{#if reason}}
<div style="margin:0 0 16px;padding:14px 16px;background:#fffbeb;border:2px solid #f59e0b;border-radius:12px;">
  <p style="margin:0 0 6px;font-size:13px;font-weight:700;color:#92400e;text-transform:uppercase;letter-spacing:0.04em;">Reason provided</p>
  <p style="margin:0;font-size:15px;line-height:1.55;color:#374151;">{{reason}}</p>
</div>
{{/if}}
<p style="margin:0 0 20px;font-size:16px;line-height:1.6;color:#374151;">
  You can respond in the dispute group chat with our support team and the other party.
</p>
<div style="margin:0 0 24px;">
  {{> actionButton url=actionUrl label="View dispute →"}}
</div>
<p style="margin:0;font-size:14px;line-height:1.5;color:#6b7280;">— The {{platformName}} team</p>
