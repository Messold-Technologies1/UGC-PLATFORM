generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthProvider {
  GOOGLE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RoleName {
  ADMIN
  CREATOR
  BRAND
}

enum PortfolioVisibilityStatus {
  PUBLIC
  PRIVATE
}

enum OrderStatus {
  PENDING_PAYMENT
  BRIEF_SUBMISSION_PENDING
  BRIEF_SUBMITTED
  BRIEF_ACCEPTED
  PRODUCT_SHIPPED
  PRODUCT_RECEIVED
  DELIVERED
  REVISION_REQUESTED
  REVISION_SUBMITTED
  ACCEPTED
  CREATOR_PAYMENT_DONE
  DISPUTED
  REJECTED
  REFUNDED
}

enum OrderDisputeStatus {
  OPEN
  RESOLVED_CONTINUE
  RESOLVED_REFUNDED
  RESOLVED_CLOSED
}

enum OrderDisputeOpenedBy {
  BRAND
  CREATOR
}

enum BrandCategory {
  APPAREL_AND_FASHION
  ELECTRONICS_AND_GADGETS
  HEALTH_AND_BEAUTY
  FOOD_AND_BEVERAGES
  HOME_AND_LIFESTYLE
  SPORTS_AND_FITNESS
  TOYS_AND_KIDS
  PETS_AND_ANIMALS
  AUTOMOBILE_AND_VEHICLES
  REAL_ESTATE
  RESTAURANTS_AND_CAFES
  CLINICS_AND_HEALTHCARE
  SALONS_AND_PERSONAL_CARE
  EDUCATION_AND_COACHING
  TRAVEL_AND_HOSPITALITY
  LOCAL_BUSINESSES
  SAAS_AND_APPS
  PROFESSIONAL_SERVICES
  OTHER
}

enum BrandProductType {
  PHYSICAL
  DIGITAL
  BOTH
}

enum CreatorFacetDimension {
  CONTENT_FORMAT
  APPEARANCE
  CONTENT_STYLE
  CAPABILITY
  LIFE_STYLE
  OCCUPATION
  CONTENT_CATEGORY
  CATEGORY_EXPERIENCE
  CAN_CREATE_WITH
  AI_CONTENT_PERMISSION
  LANGUAGE
}

enum CreatorGender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
  OTHER
}

enum CreatorContentVolumeBucket {
  NONE
  RANGE_1_5
  RANGE_5_15
  RANGE_15_25
  RANGE_25_50
  RANGE_50_PLUS
}

enum CreatorLanguageFluency {
  NATIVE
  FLUENT
  CONVERSATIONAL
}

enum CreatorAgeGroup {
  AGE_18_24
  AGE_25_34
  AGE_35_44
  AGE_45_54
  AGE_55_PLUS
}

model User {
  id                          String     @id @default(uuid()) @db.Uuid
  email                       String     @unique
  name                        String?
  passwordHash                String?
  phone                       String?
  emailVerified               Boolean    @default(false)
  phoneVerified               Boolean    @default(false)
  phoneOtpFailedAttempts      Int        @default(0)
  phoneOtpLastAttemptAt       DateTime?
  phoneOtpLastStatus          String?
  phoneOtpLastPhone           String?
  status                      UserStatus @default(ACTIVE)
  deletedAt                   DateTime?
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt
  primaryRoleId               String?    @db.Uuid
  brandAccessRevokedAt        DateTime?
  brandAccessRevokedById      String?    @db.Uuid
  brandAccessRevocationReason String?

  primaryRole            Role?                @relation("PrimaryUserRole", fields: [primaryRoleId], references: [id], onDelete: SetNull)
  authAccounts           AuthAccount[]
  sessions               Session[]
  userRoles              UserRole[]
  creatorProfile         CreatorProfile?
  brandProfile           BrandProfile?
  approvedCreatorRecords CreatorApproval[]    @relation("CreatorApprovedBy")
  featuredCreatorRecords CreatorFeature[]     @relation("CreatorFeaturedBy")
  auditLogs              AuditLog[]           @relation("AuditLogActor")
  resolvedDisputes       OrderDispute[]       @relation("OrderDisputeResolvedBy")
  sentChatMessages       OrderChatMessage[]
  orderChatReadStates    OrderChatReadState[]

  @@index([status])
  @@index([deletedAt])
  @@index([primaryRoleId])
  @@index([brandAccessRevokedAt])
  @@index([phoneOtpLastAttemptAt])
}

model AuthAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String
  refreshToken   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      RoleName @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
  primaryUsers    User[]           @relation("PrimaryUserRole")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model CreatorProfile {
  id                  String                      @id @default(uuid()) @db.Uuid
  userId              String                      @unique @db.Uuid
  displayName         String
  introVideoKey       String?
  introVideoUrl       String?
  city                String?
  countryName         String?
  stateName           String?
  bio                 String?
  gender              CreatorGender?
  dateOfBirth         DateTime?                   @db.Date
  shippingAddress     String?
  /// Primary contact email for orders and platform communication.
  contactEmail        String?
  instagramUrl        String?
  youtubeUrl          String?
  tiktokUrl           String?
  snapchatUrl         String?
  contentVolume       CreatorContentVolumeBucket?
  collaborationCount  Int                         @default(0)
  travelRadius        Int?
  onLocationAvailable Boolean                     @default(false)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  user             User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorApproval  CreatorApproval?
  facetSelections  CreatorProfileFacetSelection[]
  profileLanguages CreatorProfileLanguage[]
  restrictions     CreatorRestriction[]
  stats            CreatorStats?
  features         CreatorFeature[]
  packages         CreatorPackage[]
  addOns           CreatorAddOn[]
  portfolioVideos  CreatorPortfolioVideo[]
  receivedOrders      Order[]                        @relation("OrderCreator")
  orderDeliveries     OrderDelivery[]
  payoutDetails       CreatorPayoutDetails?
  ratingReviews       CreatorRatingReview[]

  @@index([city])
  @@index([countryName])
  @@index([dateOfBirth])
  @@index([gender])
  @@index([onLocationAvailable])
  @@index([createdAt])
}

model CreatorFacetOption {
  id        String                @id @default(uuid()) @db.Uuid
  dimension CreatorFacetDimension
  slug      String
  label     String
  sortOrder Int                   @default(0)
  createdAt DateTime              @default(now())

  selections       CreatorProfileFacetSelection[]
  profileLanguages CreatorProfileLanguage[]       @relation("LanguageOption")

  @@unique([dimension, slug])
  @@index([dimension, sortOrder])
}

model CreatorProfileFacetSelection {
  id               String   @id @default(uuid()) @db.Uuid
  creatorProfileId String   @db.Uuid
  optionId         String   @db.Uuid
  createdAt        DateTime @default(now())

  creator CreatorProfile     @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  option  CreatorFacetOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([creatorProfileId, optionId])
  @@index([optionId])
}

model CreatorProfileLanguage {
  id               String                 @id @default(uuid()) @db.Uuid
  creatorProfileId String                 @db.Uuid
  optionId         String                 @db.Uuid
  fluency          CreatorLanguageFluency
  createdAt        DateTime               @default(now())

  creator CreatorProfile     @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  option  CreatorFacetOption @relation("LanguageOption", fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([creatorProfileId, optionId])
  @@index([optionId])
}

/// Bank / UPI details for manual creator payouts. Full values are admin-only via API.
model CreatorPayoutDetails {
  id                String   @id @default(uuid()) @db.Uuid
  creatorId         String   @unique @db.Uuid
  accountHolderName String?
  accountNumber     String?
  ifsc              String?
  upiId             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  brandId          String      @db.Uuid
  creatorId        String      @db.Uuid
  /// Cleared if the listing package row is removed; use snapshot fields for purchased terms.
  creatorPackageId String?     @db.Uuid
  status           OrderStatus @default(PENDING_PAYMENT)

  // Snapshots at purchase time
  packageNameSnapshot  String
  deliverablesSnapshot Json
  priceAmountSnapshot  Decimal @db.Decimal(12, 2)
  currency             String  @default("INR")
  deliveryDaysSnapshot Int
  maxRevisionsSnapshot Int     @default(0)

  // Add-ons at purchase (catalog may change later)
  addOnsSnapshot      Json     @default("[]")
  addOnsTotalSnapshot Decimal? @db.Decimal(12, 2)
  expectedAmountPaise Int      @default(0)

  // Timeline
  paidAt             DateTime?
  briefId            String?   @db.Uuid
  briefSubmittedAt   DateTime?
  briefAcceptedAt    DateTime?

  /// Snapshot from Brief at brief submit; when true, creator must confirm receipt before first delivery
  requiresPhysicalProductShipment Boolean @default(false)
  courierName                     String?
  trackingId                      String?
  dispatchedAt                    DateTime?
  productReceivedAt               DateTime?

  deliveryDeadlineAt DateTime?
  deliveredAt        DateTime?
  acceptedAt         DateTime?
  creatorPaidAt      DateTime?
  revisionCount      Int       @default(0)

  // Razorpay Payments
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?
  razorpayRefundId  String?
  refundedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand          BrandProfile         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator        CreatorProfile       @relation("OrderCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  package        CreatorPackage?      @relation(fields: [creatorPackageId], references: [id], onDelete: SetNull)
  briefRef       Brief?               @relation(fields: [briefId], references: [id], onDelete: SetNull)
  disputes       OrderDispute[]
  deliveries     OrderDelivery[]
  chatMessages   OrderChatMessage[]
  chatReadStates OrderChatReadState[]
  ratingReview   CreatorRatingReview?

  @@index([brandId, createdAt])
  @@index([creatorId, createdAt])
  @@index([status, createdAt])
  @@index([deliveryDeadlineAt])
  @@index([briefId])
}

enum BriefShootLocationKind {
  CREATOR_OWN_SETUP
  OUTDOOR_PUBLIC_LOCATION
  BRAND_SELECTED_LOCATION
  CREATOR_DECIDES
}

enum BriefDurationBucket {
  SEC_0_15
  SEC_15_30
  SEC_30_45
  SEC_45_60
  SEC_60_100
  NOT_SURE
}

enum BriefContentType {
  TALKING_VIDEO
  PRODUCT_DEMO
  TESTIMONIAL
  AESTHETIC_REEL
  UGC_AD
  CREATOR_DECIDES
}

enum BriefToneStyle {
  FUNNY
  EMOTIONAL
  PREMIUM
  CASUAL
  TRENDY
  CREATOR_DECIDES
}

model Brief {
  id      String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid

  /// Brand / campaign context (frontend can "auto pick" from BrandProfile)
  brandName                  String?
  brandPronunciationAudioKey String?
  brandPronunciationAudioUrl String?
  industry                   String?
  brandLogoKey               String?
  brandLogoUrl               String?

  /// Product
  productName        String?
  productDescription String?
  productPageUrl     String?
  productImageKey    String?
  productImageUrl    String?

  /// Logistics: brand will mail / courier a physical item to the creator for the shoot
  willShipPhysicalProductToCreator Boolean @default(false)

  /// Production guidance
  shootLocationKind    BriefShootLocationKind? @default(CREATOR_DECIDES)
  shootLocationAddress String?

  durationBucket BriefDurationBucket? @default(NOT_SURE)
  contentType    BriefContentType[]   @default([CREATOR_DECIDES])
  toneStyle      BriefToneStyle[]     @default([CREATOR_DECIDES])

  keyNoteToInclude String?
  ctaNote          String?

  /// Links (Instagram / Drive / Youtube)
  referenceLinks Json @default("[]")

  /// Campaign script (arbitrary JSON object or array).
  script Json?

  finalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand  BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([brandId, createdAt])
}

model OrderChatMessage {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @db.Uuid
  senderUserId    String   @db.Uuid
  text            String
  clientMessageId String?
  createdAt       DateTime @default(now())

  order      Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender     User                 @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  lastReadBy OrderChatReadState[] @relation("LastReadMessage")

  @@unique([orderId, senderUserId, clientMessageId])
  @@index([orderId, createdAt])
}

model OrderChatReadState {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @db.Uuid
  userId            String    @db.Uuid
  lastReadMessageId String?   @db.Uuid
  lastReadAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessage OrderChatMessage? @relation("LastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([orderId, userId])
  @@index([orderId])
  @@index([userId])
}

model OrderDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  creatorId      String   @db.Uuid
  revisionNumber Int      @default(0)
  assets         Json
  note           String?
  createdAt      DateTime @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([orderId, revisionNumber])
  @@index([orderId, createdAt])
  @@index([creatorId, createdAt])
}

model OrderDispute {
  id               String               @id @default(uuid()) @db.Uuid
  orderId          String               @db.Uuid
  status           OrderDisputeStatus   @default(OPEN)
  openedBy         OrderDisputeOpenedBy
  reason           String
  openedAt         DateTime             @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?              @db.Uuid
  resolutionNotes  String?

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("OrderDisputeResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([status, openedAt])
}

model CreatorPortfolioVideo {
  id               String                    @id @default(uuid()) @db.Uuid
  creatorId        String                    @db.Uuid
  videoKey         String
  videoUrl         String
  thumbnailKey     String?
  thumbnailUrl     String?
  industryLabel    String?
  language         String?
  description      String?
  visibilityStatus PortfolioVisibilityStatus @default(PUBLIC)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  creator CreatorProfile             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  tags    CreatorPortfolioVideoTag[]

  @@index([creatorId, visibilityStatus, createdAt])
  @@index([creatorId, createdAt])
  @@index([visibilityStatus, industryLabel])
}

model CreatorPortfolioVideoTag {
  id        String   @id @default(uuid()) @db.Uuid
  videoId   String   @db.Uuid
  tag       String
  createdAt DateTime @default(now())

  video CreatorPortfolioVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, tag])
  @@index([tag])
}

model PortfolioIndustrySuggestion {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
}

model PortfolioTagSuggestion {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
}

model PortfolioLanguageSuggestion {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
}

model CreatorApproval {
  id              String         @id @default(uuid()) @db.Uuid
  creatorId       String         @unique @db.Uuid
  status          ApprovalStatus @default(PENDING)
  approvedById    String?        @db.Uuid
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  approvedBy User?          @relation("CreatorApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([approvedById])
}

model CreatorRestriction {
  id          String   @id @default(uuid()) @db.Uuid
  creatorId   String   @db.Uuid
  restriction String
  createdAt   DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, restriction])
  @@index([restriction])
}

model CreatorRestrictionSuggestion {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
}

model BrandProfile {
  id                         String            @id @default(uuid()) @db.Uuid
  userId                     String            @unique @db.Uuid
  brandName                  String
  logoKey                    String?
  logoUrl                    String?
  website                    String?
  /// Primary contact name on the brand profile form.
  contactFullName            String?
  contactEmail               String?
  contactPhone               String?
  brandPronunciationAudioKey String?
  brandPronunciationAudioUrl String?
  instagramUrl               String?
  productType                BrandProductType?
  otherCategoryLabel         String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  briefs          Brief[]
  brandCategories BrandProfileBrandCategory[]
  ratingReviews   CreatorRatingReview[]
}

model BrandProfileBrandCategory {
  id             String        @id @default(uuid()) @db.Uuid
  brandProfileId String        @db.Uuid
  category       BrandCategory

  brand BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@unique([brandProfileId, category])
  @@index([brandProfileId])
}

model CreatorStats {
  id                 String   @id @default(uuid()) @db.Uuid
  creatorId          String   @unique @db.Uuid
  totalOrders        Int      @default(0)
  completedOrders    Int      @default(0)
  cancelledOrders    Int      @default(0)
  disputesCount      Int      @default(0)
  avgRating          Decimal? @db.Decimal(3, 2)
  reviewCount        Int      @default(0)
  responseTimeAvg    Int? // in minutes
  onTimeDeliveryRate Decimal? @db.Decimal(5, 2)
  acceptanceRate     Decimal? @db.Decimal(5, 2)
  updatedAt          DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

/// Brand rating + review for a creator on a completed order (one row per order).
model CreatorRatingReview {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @unique @db.Uuid
  brandId   String   @db.Uuid
  creatorId String   @db.Uuid
  rating    Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brand   BrandProfile   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, createdAt])
  @@index([brandId, createdAt])
}

model CreatorFeature {
  id            String    @id @default(uuid()) @db.Uuid
  creatorId     String    @db.Uuid
  isFeatured    Boolean   @default(false)
  featuredById  String?   @db.Uuid
  featuredUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  featuredBy User?          @relation("CreatorFeaturedBy", fields: [featuredById], references: [id], onDelete: SetNull)

  @@index([creatorId, isFeatured])
  @@index([featuredUntil])
}

model CreatorPackage {
  id                 String   @id @default(uuid()) @db.Uuid
  creatorId          String   @unique @db.Uuid
  name               String
  title              String?
  deliverables       Json // array of strings e.g. ["1 Video", "Basic editing"]
  videoLengthSeconds Int      @default(60)
  priceAmount        Decimal  @db.Decimal(12, 2)
  deliveryDays       Int      @default(5)
  maxRevisions       Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([creatorId])
  @@index([priceAmount])
}

model CreatorAddOn {
  id          String   @id @default(uuid()) @db.Uuid
  creatorId   String   @db.Uuid
  name        String
  priceAmount Decimal  @db.Decimal(12, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

/// Catalog of predefined add-ons creators can attach to their profile.
model CreatorAddOnOption {
  id        String @id @default(uuid()) @db.Uuid
  slug      String @unique
  name      String @unique
  sortOrder Int    @default(0)

  /// When set, price must equal this amount.
  fixedPrice Int?

  /// When fixedPrice is null, enforce minPrice and stepPrice.
  minPrice  Int?
  stepPrice Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
