  createdAt         DateTime @default(now())

  order           Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedByUser User  @relation("OrderRevisionRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)

