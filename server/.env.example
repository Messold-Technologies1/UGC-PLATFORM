# Neon PostgreSQL – use pooled URL for runtime, direct URL for migrations
# From Neon dashboard: Connection Details -> Pooled connection & Direct connection
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Server
NODE_ENV=development
PORT=4000

# Optional: enable Swagger in production (default: enabled when NODE_ENV !== production)
# SWAGGER_ENABLED=true

# Optional: CORS allowed origin (default: *)
# CORS_ORIGIN=http://localhost:3000

# Auth: JWT (min 16 chars each)
JWT_ACCESS_SECRET=your-access-secret-min-16-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Auth: Google OAuth (create app at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
