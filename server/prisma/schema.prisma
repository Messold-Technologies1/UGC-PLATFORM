/// A creator's linked external account used as a *data source* for audience
/// metrics (Instagram now; YouTube/Reddit later). Distinct from AuthAccount,
/// which is sign-in identity. Holds the OAuth tokens (encrypted at rest via the
/// app-level crypto util) plus a small set of denormalized "latest" values for
/// quick profile display without touching the snapshot tables.
/// A creator's reels, cached from `GET /me/media` so the gallery never calls
/// Graph on the request path. Only REELS are stored — photos and carousels are
/// discarded during the page walk.
model InstagramMediaItem {
  id           String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid

  /// Instagram's stable media id — the only durable IG identifier.
  igMediaId String

  mediaType        String
  mediaProductType String?
  permalink        String?
  caption          String?

  /// Short-lived signed CDN URLs. Never treated as durable: `urlsExpireAt` is a
  /// conservative estimate of when they stop working.
  mediaUrl     String?
  thumbnailUrl String?
  urlsExpireAt DateTime?

  postedAt        DateTime?
  durationSeconds Int?
  likeCount       Int?
  commentsCount   Int?
  viewCount       Int?

  /// Set once this reel has been imported, so the gallery can dim it. A real
  /// foreign key with ON DELETE SET NULL: when the portfolio video is deleted
  /// the pointer clears itself and the reel becomes selectable again. As a bare
  /// uuid this rotted into a dangling id and the tile read "Added" forever.
  importedVideoId String? @db.Uuid

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection    SocialConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  importedVideo CreatorPortfolioVideo? @relation(fields: [importedVideoId], references: [id], onDelete: SetNull)

  @@unique([connectionId, igMediaId])
  /// Drives the gallery's keyset pagination (postedAt desc, igMediaId desc).
  @@index([connectionId, mediaProductType, postedAt(sort: Desc), igMediaId(sort: Desc)])
  @@index([importedVideoId])
}

/// One row per connection: where the page walk got to, and how fresh the cache
/// is. The 7-day TTL is measured from `lastSyncedAt`.
model InstagramMediaSyncState {
  connectionId String            @id @db.Uuid
  status       IgMediaSyncStatus @default(IDLE)

  /// Graph's `paging.cursors.after`, for resuming a partial walk. Server-side
  /// only — never confused with the gallery's own keyset cursor.
  nextCursor   String?
  hasMore      Boolean @default(true)
  pagesFetched Int     @default(0)
  reelCount    Int     @default(0)

  /// When a sync batch last completed successfully. Deliberately *not* "last
  /// full walk": a batch that stops at its reel budget still refreshed the top
  /// of the account, and `hasMore` already says whether more remains to page
  /// in. Stamping this only on a complete walk left a 1000-reel account
  /// permanently "stale", which made the gallery re-sync on every open.
  lastSyncedAt DateTime?
  /// Rate-limits the manual Refresh button server-side.
  lastRefreshAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt

  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([lastSyncedAt])
}

model SocialConnection {
  id                String                 @id @default(uuid()) @db.Uuid
  creatorProfileId  String                 @db.Uuid
  platform          SocialPlatform
  /// Platform's stable account id (IG user id / YT channel id / Reddit id).
  providerAccountId String
  username          String?
  /// e.g. BUSINESS / CREATOR / PERSONAL when the platform reports it.
  accountType       String?
  /// Encrypted (AES-256-GCM). Never returned to clients.
  accessToken       String
  /// Encrypted. Null for platforms with non-refreshable long-lived tokens (IG).
  refreshToken      String?
  tokenExpiresAt    DateTime?
  scopes            String[]
  status            SocialConnectionStatus @default(ACTIVE)

  /// Denormalized "latest" values, overwritten each sync — this row is the
  /// single source of truth for a connection's current numbers (no per-day rows).
  followersCount   Int?
  mediaCount       Int?
  /// De-duplicated reach over the last 30 days (Instagram `total_value`).
  reach30d         Int?
  /// Views over the last 30 days.
  views30d         Int?
  /// Profile views over the last 30 days.
  profileViews30d  Int?
  /// When the 30-day metrics above were last refreshed.
  metricsUpdatedAt DateTime?

  lastSyncedAt   DateTime?
  lastSyncStatus String?
  lastSyncError  String?
  connectedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  creator       CreatorProfile           @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  audience      SocialAudienceSnapshot?
  mediaItems    InstagramMediaItem[]
  mediaSyncState InstagramMediaSyncState?

  /// One platform account maps to a single creator.
  @@unique([platform, providerAccountId])
  /// One connection per platform per creator.
  @@unique([creatorProfileId, platform])
  @@index([status])
  @@index([creatorProfileId])
  @@index([tokenExpiresAt])
}

/// An account's *audience demographics* — one row per connection, overwritten
/// each sync. Instagram `follower_demographics` (period=lifetime) per breakdown;
/// requires >=100 followers, otherwise the maps stay null. Full distributions
/// are stored as JSON exactly as the platform returns them — "top 5 cities",
/// "top countries", age/gender splits are derived at read time so nothing is
/// lost and the cutoff can change without a re-fetch.
model SocialAudienceSnapshot {
  id               String         @id @default(uuid()) @db.Uuid
  connectionId     String         @unique @db.Uuid
  creatorProfileId String         @db.Uuid
  platform         SocialPlatform
  /// "As of" date of this demographics snapshot (overwritten each sync).
  snapshotDate     DateTime       @db.Date

  /// Followers at snapshot time (context for interpreting the distributions).
  followerCount Int?

  ageBreakdown     Json? // { "18-24": 1200, "25-34": 3400, ... }
  genderBreakdown  Json? // { "F": 5000, "M": 3000, "U": 200 }
  cityBreakdown    Json? // { "Mumbai, Maharashtra": 800, ... }
  countryBreakdown Json? // { "IN": 9000, "US": 500, ... }

  /// Untouched API payload for audit / future breakdowns.
  raw         Json?
  collectedAt DateTime @default(now())

  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([creatorProfileId, platform])
}

// ─── Legal Pages (Dynamic, Admin-Editable) ─────────────────────────

enum LegalDraftStatus {
  DRAFT
  IN_REVIEW
}

/// Top-level container for a legal page (Privacy Policy, Terms of Service, etc.).
/// The `slug` is the URL identifier used by the public-facing page.
/// Live content is stored in related `LegalSection` rows.
model LegalPage {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  title         String
  description   String
  effectiveDate String
  sections      Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedBy     String?  @db.Uuid

  // Draft State
  draftStatus                LegalDraftStatus?
  draftTitle                 String?
  draftDescription           String?
  draftEffectiveDate         String?
  draftSections              Json?
  draftChangeNote            String?
  draftCreatedBy             String?           @db.Uuid
  draftReviewNote            String?
  draftCreatedAt             DateTime?
  draftUpdatedAt             DateTime?
  draftRestoredFromVersionId String?           @db.Uuid

  versions LegalPageVersion[]

  @@index([slug])
}

/// Immutable snapshot created each time a draft is published. Captures the
/// entire page state (meta + sections) so admins can review history.
model LegalPageVersion {
  id                    String   @id @default(uuid()) @db.Uuid
  pageId                String   @db.Uuid
  snapshot              Json
  changedBy             String   @db.Uuid
  changeNote            String?
  restoredFromVersionId String?  @db.Uuid
  createdAt             DateTime @default(now())

  page LegalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
}
